# Ordenes Service Environment Configuration
NODE_ENV=production
PORT=4002

# Service Discovery
INVENTARIOS_URL=https://inventarios.example.com

# SQS Configuration
SQS_ENDPOINT=https://sqs.us-east-1.amazonaws.com
ORDER_CREATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/order-creation
AWS_REGION=us-east-1

# SNS Configuration
SNS_ENDPOINT=https://sns.us-east-1.amazonaws.com
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:order-events

# AWS Credentials
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Database Configuration
DB_TYPE=postgresql
DB_HOST=ordenes-db.example.com
DB_PORT=5432
DB_NAME=ordenes
DB_USER=ordenes_user
DB_PASSWORD=secure_password

# Worker Configuration
WORKER_ID=worker-1

# Health Check
HEALTH_CHECK_ENDPOINT=/health

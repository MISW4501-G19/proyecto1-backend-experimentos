{
  "family": "medysupply-migration-job-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "inventarios-migration",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/medysupply-inventarios:staging",
      "essential": true,
      "command": ["node", "migrate.js", "migrate"],
      "environment": [
        {"name": "NODE_ENV", "value": "production"},
        {"name": "DB_TYPE", "value": "postgresql"},
        {"name": "DB_HOST", "value": "medysupply-stage.coxaygocuy37.us-east-1.rds.amazonaws.com"},
        {"name": "DB_PORT", "value": "5432"},
        {"name": "DB_NAME", "value": "medysupply_inventory"},
        {"name": "DB_USER", "value": "postgres"},
        {"name": "RUN_MIGRATIONS", "value": "false"},
        {"name": "RUN_SEEDERS", "value": "false"}
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID:parameter/medysupply/staging/db-password"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/medysupply-migration-job-staging",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "inventarios-migration"
        }
      }
    },
    {
      "name": "ordenes-migration",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/medysupply-ordenes:staging",
      "essential": true,
      "command": ["node", "migrate.js", "migrate"],
      "environment": [
        {"name": "NODE_ENV", "value": "production"},
        {"name": "DB_TYPE", "value": "postgresql"},
        {"name": "DB_HOST", "value": "medysupply-stage.coxaygocuy37.us-east-1.rds.amazonaws.com"},
        {"name": "DB_PORT", "value": "5432"},
        {"name": "DB_NAME", "value": "medysupply_orders"},
        {"name": "DB_USER", "value": "postgres"},
        {"name": "RUN_MIGRATIONS", "value": "false"},
        {"name": "RUN_SEEDERS", "value": "false"}
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-1:ACCOUNT_ID:parameter/medysupply/staging/db-password"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/medysupply-migration-job-staging",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ordenes-migration"
        }
      }
    }
  ]
}
